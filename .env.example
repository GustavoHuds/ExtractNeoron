# Copy to .env and fill in. .env is git-ignored — NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ===== Dashboard / server (required to run `npm run serve` or Docker) =====

# Firebase project id of the Neoron backend (leave as-is unless it changes).
NEORON_PROJECT=neoron

# Neoron's public Firebase WEB API key. It is public by design (it ships in the
# browser), but it is kept out of source so secret scanners don't flag the repo.
# Get it from Neoron's web app, or reuse the value your team already has.
NEORON_API_KEY=

# Access control (optional). Comma-separated allow-list of e-mails that may sign
# in. Leave EMPTY to allow any valid Neoron account (fine behind a VPN).
# Example: AUTHORIZED_EMAILS=fulano@empresa.com,beltrano@empresa.com
AUTHORIZED_EMAILS=

# Network bind + port. In Docker this stays 0.0.0.0 (the compose file maps it to
# 127.0.0.1 only). Running bare on a trusted LAN? 0.0.0.0 exposes it to the LAN.
HOST=0.0.0.0
PORT=3000

# How many hours without a reply counts as "idle" for lead scoring.
IDLE_THRESHOLD_HOURS=24

# ===== Nota IA do atendimento (opcional) =====
# Chave da API da Anthropic (https://platform.claude.com). Com ela preenchida,
# cada conversa ganha uma nota 0-10 do atendimento do vendedor (modelo barato,
# transcript compacto e cache por conversa — só gasta tokens quando o chat muda).
# Vazio = recurso desligado; o painel funciona normalmente.
# É um SEGREDO de verdade — nunca commitar.
ANTHROPIC_API_KEY=
# Modelo usado na nota (padrão: claude-haiku-4-5, o mais barato).
# AI_MODEL=claude-haiku-4-5

# Dias de retenção dos leads finalizados (aba "Finalizados"). Padrão: 180.
# DONE_RETENTION_DAYS=180

# (Optional) absolute path to a catalog JSON. Normally you import the catalog
# from the dashboard ("Catálogo" button) instead of setting this.
# CATALOG_PATH=

# ===== discover.js only (local mapping tool — NOT needed on the server) =====
# The dashboard does NOT use these; each user logs in via the browser.
# Only fill these if you run `npm run discover` locally to map Neoron's schema.
NEORON_URL=https://app.neoron.io/dashboard
NEORON_EMAIL=you@example.com
NEORON_PASSWORD=your-password-here
NEGOCIANDO_TAG_NAME=negociando
# Set to "false" to watch the browser during discovery.
HEADLESS=true
