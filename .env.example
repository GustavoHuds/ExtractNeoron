# Copy to .env and fill in. .env is git-ignored — never commit real credentials.
NEORON_URL=https://app.neoron.io/dashboard
NEORON_EMAIL=you@example.com
NEORON_PASSWORD=your-password-here

# Nome da etiqueta (tag) a filtrar no Neoron.
NEGOCIANDO_TAG_NAME=negociando

# (Opcional) caminho do catálogo para casar produtos. Padrão: "Catálogo - ref/data/catalogo-dados.json".
# CATALOG_PATH=

# Set to "false" to watch the browser (usado só pelo discover.js).
HEADLESS=true

# Porta do dashboard (acessível na rede local).
PORT=3000
