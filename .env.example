# Copy to .env and fill in. .env is git-ignored — NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ===== Server (required) =====

# Firebase project id of the Neoron backend (leave as-is unless it changes).
NEORON_PROJECT=neoron

# Neoron's public Firebase WEB API key. Public by design (it ships in Neoron's
# own browser app), but kept out of source so secret scanners don't flag the
# repo and so it stays configurable per environment.
NEORON_API_KEY=

# Access control (optional). Comma-separated allow-list of e-mails that may
# sign in. Empty = any valid Neoron account (fine behind a VPN).
# AUTHORIZED_EMAILS=fulano@empresa.com,beltrano@empresa.com
AUTHORIZED_EMAILS=

# Network bind + port. In Docker keep 0.0.0.0 (compose maps it to 127.0.0.1).
HOST=0.0.0.0
PORT=3000

# ===== Behaviour tuning (optional) =====

# Hours a customer can wait for a human reply before entering the call queue.
CALL_QUEUE_HOURS=24

# Waiting longer than this many days drops the lead from the call queue
# (considered lost — still visible in the pipeline).
CALL_QUEUE_MAX_DAYS=14

# Days of retention for concluded leads (Finalizados tab) and caches.
DONE_RETENTION_DAYS=180

# ===== Nota IA do atendimento (optional) =====
# Anthropic API key (https://platform.claude.com). When set, each conversation
# gets a 0-10 score of the salesperson's service (cheap model, compact
# transcript, cached per chat — only spends tokens when the chat changes).
# Empty = feature off; the dashboard works normally. A REAL secret.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-4-5

# (Optional) absolute path to a catalog JSON. Normally you import the catalog
# from the dashboard ("Catálogo" button) instead.
# CATALOG_PATH=

# ===== scripts/discover.mjs only (local schema-mapping tool) =====
# The dashboard does NOT use these; each user logs in via the browser.
NEORON_EMAIL=
NEORON_PASSWORD=
